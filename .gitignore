# Allow application source and project documentation
/*
!/backend/
!/frontend/
!/.gitignore
!/README.md

# Allow the GitHub pull request template
!/.github/
/.github/*
!/.github/pull_request_template.md

# Sensitive files
.env
.env.*
!.env.example
*.pem
*.key

# Dependencies and generated files
node_modules/
coverage/
build/
dist/
.DS_Store
*.log

# Databases
*.sql
*.sql.gz
*.dump
*.sqlite
*.sqlite3
